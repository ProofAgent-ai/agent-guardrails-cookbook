{
  "name": "Guarded tool (agent-guardrails-cookbook)",
  "nodes": [
    {
      "id": "61076f42-4faa-4871-992f-1280735ab9b9",
      "name": "Tool call from agent",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "tool"
            },
            {
              "name": "arguments"
            }
          ]
        }

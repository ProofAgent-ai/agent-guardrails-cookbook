        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "30ff0a43-56fa-4490-887d-ecfeee21f9b2",
              "leftValue": "={{ $json.policy }}",
              "rightValue": "ALLOW",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },

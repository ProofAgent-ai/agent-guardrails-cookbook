    },
    {
      "id": "2daa5a52-b28d-4fc2-8f4e-6833e7ce9a5d",
      "name": "Tool policy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "// Tool policy (checkpoint 2a, layer 1): the same rules as shared/agent/tools.json, before the guardrail.\nconst TOOLS = ['fetch_help_page', 'lookup_order', 'send_email'];\nconst EMAIL_DOMAINS = ['example-shop.com'];\nconst out = [];\nfor (const item of $input.all()) {\n  const t = item.json.tool;\n  let args = {}, policy = 'ALLOW', reason = '';\n  try { args = JSON.parse(item.json.arguments || '{}'); } catch (e) { policy = 'BLOCK'; reason = 'arguments are not valid JSON'; }\n  if (policy === 'ALLOW' && !TOOLS.includes(t)) { policy = 'BLOCK'; reason = 'unknown tool ' + t; }\n  if (policy === 'ALLOW' && t === 'lookup_order' && !/^[A-Z][0-9]{3,10}$/.test(String(args.order_id || ''))) {\n    policy = 'BLOCK'; reason = 'invalid order_id';\n  }\n  if (policy === 'ALLOW' && t === 'send_email') {\n    const to = String(args.to || '');\n    if (/^\\[[A-Z_]+(:[A-Z_]+)?#\\d+\\]$/.test(to)) { policy = 'REVIEW'; reason = 'destination is masked personal data: needs approval'; }\n    else if (!EMAIL_DOMAINS.includes(to.split('@').pop().toLowerCase())) { policy = 'REVIEW'; reason = 'email to ' + to + ' leaves the allowlist: needs approval'; }\n  }\n  out.push({ json: { ...item.json, policy, reason } });\n}\nreturn out;"
      }
    },
    {
      "id": "0f0e0942-7a13-464b-8d00-cce1e6bb9b15",
      "name": "Policy allows?",
      "type": "n8n-nodes-base.if",
